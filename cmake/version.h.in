/* cabbird/sdk/version.h -- GENERATED at configure time from cmake/version.h.in.
 *
 * Do not edit this file: it lives in the build tree (generated/sdk-install/include) and is what
 * the SDK component installs.  The version comes from CABBIRD_RELEASE_VERSION, so a release tag
 * carries itself into the header -- there is nothing to keep in sync by hand.
 */
#pragma once

#define CABBIRD_SDK_VERSION_MAJOR @PROJECT_VERSION_MAJOR@u
#define CABBIRD_SDK_VERSION_MINOR @PROJECT_VERSION_MINOR@u
#define CABBIRD_SDK_VERSION_PATCH @PROJECT_VERSION_PATCH@u
#define CABBIRD_SDK_VERSION_STRING "@CABBIRD_VERSION_STRING@"

/* The plugin ABI is versioned separately from the SDK: the SDK can gain services
 * without breaking a compiled plugin, but the descriptor layout is frozen per
 * major. */
#define CABBIRD_PLUGIN_API_V1_MAJOR 1u
#define CABBIRD_PLUGIN_API_V1_MINOR 0u

/* The one symbol a plugin DLL must export.  The host resolves exactly this name;
 * a plugin that exports it with the wrong calling convention or mangled name is
 * reported as "not a Cabbird plugin" rather than crashing the loader. */
#define CABBIRD_PLUGIN_V1_ENTRY_NAME "CabbirdPluginEntryV1"

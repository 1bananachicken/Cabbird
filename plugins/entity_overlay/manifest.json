{
  "schemaVersion": 2,
  "id": "cabbird.entity-overlay",
  "name": "Entity Overlay",
  "author": "Cabbird",
  "license": "AGPL-3.0-only",
  "version": "0.1.31",
  "description": "Consumes entity snapshots from cabbird.unity.entities and draws boxes and labels through cabbird.unity.overlay.",
  "entry": "plugin.dll",
  "api": {
    "major": 1,
    "minMinor": 0,
    "maxMinor": 0
  },
  "games": [
    "ap"
  ],
  "builds": [
    "ap-*"
  ],
  "loadPhase": "game-ready",
  "services": [
    {
      "id": "cabbird.ui",
      "minVersion": 1
    },
    {
      "id": "cabbird.config",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "cabbird.unity.overlay",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "cabbird.unity.entities",
      "minVersion": 1,
      "optional": true
    }
  ],
  "capabilities": [
    "ui",
    "configuration",
    "unity-overlay",
    "unity-entities"
  ]
}
